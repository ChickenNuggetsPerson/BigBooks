model Employee {
  uuid        String @id @unique @default(uuid())
  firstName   String @default("")
  middleName  String @default("")
  lastName    String @default("")
  notes       String @default("")
  address     String @default("")
  email       String @default("")
  phoneNumber String @default("")
  ssn         String @default("")

  filingStatus FilingTypes     @default(Single)
  dependants   Int             @default(0)
  residence    AvaliableStates @default(Other)

  isDeleted Boolean @default(false)

  organization   Organization @relation(fields: [organizationId], references: [uuid], onDelete: Cascade)
  organizationId String

  compensations EmployeeCompensation[]
  payStubs      PayStub[]

  defaultPayrollItems PayrollItem[]

  payrollDrafts PayrollDraft[]
}

model EmployeeCompensation {
  uuid       String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [uuid], onDelete: Cascade)
  employeeId String

  payrollGroup   PayrollGroup @relation(fields: [payrollGroupId], references: [uuid], onDelete: Cascade)
  payrollGroupId String

  isSalary     Boolean      @default(true)
  salaryAmount Decimal?
  hourlyRates  HourlyRate[]

  description String?

  paystubItems PayStubItem[]

  @@unique([employeeId, payrollGroupId]) // no duplicate “employee‐group” rows
}

model HourlyRate {
  uuid String @id @unique @default(uuid())

  name        String
  rate        Decimal
  canOvertime Boolean

  compensation   EmployeeCompensation @relation(fields: [compensationId], references: [uuid], onDelete: Cascade)
  compensationId String

  paystubItems PayStubItem[]
}

model Organization {
  uuid      String  @id @unique @default(uuid())
  name      String
  notes     String  @default("")
  address   String  @default("")
  isDeleted Boolean @default(false)

  employees     Employee[]
  payrollGroups PayrollGroup[]

  inviteCodes InviteCode[]
  memberships Membership[]

  defaultPayrollItems PayrollItem[]

  orgTaxes Tax[]
}

model PayrollGroup {
  uuid        String @id @unique @default(uuid())
  name        String
  description String

  payFrequency  Int      @default(14) // e.g. days
  payRefDate    DateTime @default(now())
  periodRefDate DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [uuid], onDelete: Cascade)
  organizationId String

  compensations EmployeeCompensation[]

  defaultPayrollItems PayrollItem[]
}

enum AbsMaxPeriodTypes {
  None
  Month
  Year
}

model PayrollItem {
  uuid String @id @default(uuid())

  organization   Organization? @relation(fields: [organizationId], references: [uuid], onDelete: Cascade)
  organizationId String?
  payrollGroup   PayrollGroup? @relation(fields: [payrollGroupId], references: [uuid], onDelete: Cascade)
  payrollGroupId String?
  employee       Employee?     @relation(fields: [employeeId], references: [uuid], onDelete: Cascade)
  employeeId     String?

  type        PayStubItemType
  name        String
  description String?

  percent Decimal?
  amount  Decimal

  absMaxPeriod AbsMaxPeriodTypes @default(None)
  absMax       Decimal           @default(0)

  PayStubItem PayStubItem[]
}

model PayrollDraft {
  uuid String @id @unique @default(uuid())

  membership          Membership  @relation(fields: [membershipId], references: [uuid], onDelete: Cascade)
  membershipId        String
  activeForMembership Membership? @relation("ActiveDraft")

  startedDate DateTime @default(now())

  periodStart   DateTime
  periodEnd     DateTime
  periodPaydate DateTime

  employees Employee[]
  paystubs  PayStub[]
}

model PayStub {
  uuid        String   @id @unique @default(uuid())
  payDate     DateTime
  periodStart DateTime
  periodEnd   DateTime

  locked        Boolean   @default(false)
  lockedTime    DateTime?
  submittedTime DateTime?

  // Totals or summaries (computed at generation time)
  grossEarnings Decimal @default(0)
  totalTaxes    Decimal @default(0)
  totalExtras   Decimal @default(0)
  netPay        Decimal @default(0)

  employee   Employee @relation(fields: [employeeId], references: [uuid], onDelete: Cascade)
  employeeId String

  // Children:
  items PayStubItem[]

  relatedPayrollDraft   PayrollDraft? @relation(fields: [relatedPayrollDraftId], references: [uuid], onDelete: SetNull)
  relatedPayrollDraftId String?
}

enum PayStubItemType {
  Earning
  Tax
  Other
}

model PayStubItem {
  uuid String @id @default(uuid())

  payStub   PayStub @relation(fields: [payStubId], references: [uuid], onDelete: Cascade)
  payStubId String

  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [uuid], onDelete: SetNull)
  payrollItemId String?

  compensation   EmployeeCompensation? @relation(fields: [compensationId], references: [uuid], onDelete: SetNull)
  compensationId String?

  hourlyRate   HourlyRate? @relation(fields: [hourlyRateId], references: [uuid], onDelete: SetNull)
  hourlyRateId String?

  tax   TaxSnapshot? @relation(fields: [taxID], references: [uuid], onDelete: SetNull)
  taxID String?

  type        PayStubItemType
  name        String
  description String?

  hours   Decimal?
  rate    Decimal?
  percent Decimal?
  amount  Decimal
}

enum FilingTypes {
  Single
  Joint
}

enum AvaliableStates {
  Other
  Utah
}

enum TaxType {
  FlatRate
  FlatAmmount
  ProgressiveRate
}

model Tax {
  uuid               String  @id @unique @default(uuid())
  sysAdminControlled Boolean @default(false)

  organization   Organization? @relation(fields: [organizationID], references: [uuid], onDelete: Cascade)
  organizationID String?

  name        String
  description String?
  state       AvaliableStates @default(Other)

  archived Boolean @default(false)

  snapshots TaxSnapshot[]
}

model TaxSnapshot {
  uuid  String @id @unique @default(uuid())
  tax   Tax    @relation(fields: [taxId], references: [uuid], onDelete: Cascade)
  taxId String

  effectiveThrough DateTime
  supportsJoint    Boolean  @default(false)
  taxType          TaxType  @default(ProgressiveRate)

  description String?
  brackets    TaxBracket[]

  paystubItems PayStubItem[]
}

model TaxBracket {
  uuid          String      @id @unique @default(uuid())
  taxSnapshot   TaxSnapshot @relation(fields: [taxSnapshotId], references: [uuid], onDelete: Cascade)
  taxSnapshotId String

  min         Decimal @default(0)
  hasMinBound Boolean
  max         Decimal @default(0)
  hasMaxBound Boolean

  filingType FilingTypes @default(Single)

  rate    Decimal @default(0)
  ammount Decimal @default(0)
}

model User {
  uuid     String  @id @unique @default(uuid())
  isActive Boolean

  firstName String
  lastName  String

  email String

  username String @unique
  passHash String @unique

  memberships Membership[]

  allocatedOrganizations Int @default(0)
}

model RegistrationCode {
  uuid    String   @id @unique @default(uuid())
  expires DateTime
}

model InviteCode {
  uuid String @id @unique @default(uuid())

  organization   Organization @relation(fields: [organizationId], references: [uuid], onDelete: Cascade)
  organizationId String

  perms String[]

  expires DateTime
}

model Membership {
  uuid   String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [uuid], onDelete: Cascade)
  userId String

  organization   Organization @relation(fields: [organizationId], references: [uuid], onDelete: Cascade)
  organizationId String

  orgAdmin    Boolean  @default(false)
  permissions String[]
  joinedAt    DateTime @default(now())

  payrollDrafts PayrollDraft[]
  activeDraft   PayrollDraft?  @relation("ActiveDraft", fields: [activeDraftId], references: [uuid])
  activeDraftId String?        @unique

  @@unique([userId, organizationId]) // Prevents duplicate entries
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/database/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
