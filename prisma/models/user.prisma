model User {
    uuid     String  @id @unique @default(uuid())
    isActive Boolean

    firstName String
    lastName  String

    email String

    username String @unique
    passHash String @unique

    memberships Membership[]

    allocatedOrganizations Int @default(0)
}

model RegistrationCode {
    uuid    String   @id @unique @default(uuid())
    expires DateTime
}

model InviteCode {
    uuid String @id @unique @default(uuid())

    organization   Organization @relation(fields: [organizationId], references: [uuid])
    organizationId String

    perms String[]

    expires DateTime
}

model Membership {
    uuid   String @id @default(uuid())
    user   User   @relation(fields: [userId], references: [uuid])
    userId String

    organization   Organization @relation(fields: [organizationId], references: [uuid])
    organizationId String

    orgAdmin    Boolean  @default(false)
    permissions String[]
    joinedAt    DateTime @default(now())

    payrollDrafts PayrollDraft[]
    activeDraft   PayrollDraft?  @relation("ActiveDraft", fields: [activeDraftId], references: [uuid])
    activeDraftId String?        @unique

    @@unique([userId, organizationId]) // Prevents duplicate entries
}
